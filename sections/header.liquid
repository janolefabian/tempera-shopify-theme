{%- liquid
  assign site_language = 'en'
  if request.locale.iso_code == 'de'
    assign site_language = 'de'
  endif
  assign main_site = 'https://www.tempera-strings.com/' | append: site_language
-%}

<header class="tempera-header" data-tempera-header>
  <a class="logo-home" href="{{ main_site }}" aria-label="Tempera Strings">
    <span>Tempera</span>
  </a>

  <nav class="navigation d-none d-md-flex" aria-label="Main navigation">
    <ul class="menu-list">
      {%- for link in section.settings.menu.links -%}
        {%- liquid
          assign nav_url = link.url
          assign nav_key = link.title | handleize
          case nav_key
            when 'about', 'uber-uns', 'ueber-uns'
              assign nav_url = main_site | append: '/about'
            when 'partners', 'partner'
              assign nav_url = main_site | append: '/partners'
            when 'faq'
              assign nav_url = main_site | append: '/faq'
            when 'contact', 'kontakt'
              assign nav_url = main_site | append: '/contact'
            when 'products', 'produkte'
              assign nav_url = main_site | append: '/products'
            when 'shop'
              assign nav_url = routes.root_url
          endcase
        -%}
        <li{% if nav_key == 'shop' %} class="selected"{% endif %}>
          <a href="{{ nav_url }}"{% if nav_key == 'shop' %} aria-current="page"{% endif %}>
            <span>{{ link.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    <ul class="langswitcher">
      <li>
        <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
          {%- if cart == empty -%}
            {% render 'icon-cart-empty' %}
          {%- else -%}
            {% render 'icon-cart' %}
          {%- endif -%}
          <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
          {%- if cart != empty -%}
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}<span aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>
      </li>
    </ul>
  </nav>

  <nav class="navigation-mobile" id="TemperaMobileMenu" aria-label="Mobile navigation" hidden>
    <ul class="menu-list mm">
      {%- for link in section.settings.menu.links -%}
        {%- liquid
          assign nav_url = link.url
          assign nav_key = link.title | handleize
          case nav_key
            when 'about', 'uber-uns', 'ueber-uns'
              assign nav_url = main_site | append: '/about'
            when 'partners', 'partner'
              assign nav_url = main_site | append: '/partners'
            when 'faq'
              assign nav_url = main_site | append: '/faq'
            when 'contact', 'kontakt'
              assign nav_url = main_site | append: '/contact'
            when 'products', 'produkte'
              assign nav_url = main_site | append: '/products'
            when 'shop'
              assign nav_url = routes.root_url
          endcase
        -%}
        <li{% if nav_key == 'shop' %} class="selected"{% endif %}>
          <a href="{{ nav_url }}"{% if nav_key == 'shop' %} aria-current="page"{% endif %}>
            <span>{{ link.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>

  <a href="{{ routes.cart_url }}" class="mob-only header__icon header__icon--cart link focus-inset" id="cart-icon-bubble-mobile">
    {%- if cart == empty -%}
      {% render 'icon-cart-empty' %}
    {%- else -%}
      {% render 'icon-cart' %}
    {%- endif -%}
    <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
    {%- if cart != empty -%}
      <div class="cart-count-bubble">
        {%- if cart.item_count < 100 -%}<span aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
        <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
      </div>
    {%- endif -%}
  </a>

  <button class="sandwich d-md-none" type="button" aria-controls="TemperaMobileMenu" aria-expanded="false" data-tempera-menu-toggle>
    <span class="visually-hidden">Menu</span>
  </button>
</header>

{%- if settings.cart_type == 'notification' -%}
  {{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
  {% render 'cart-notification', color_scheme: 'background-1' %}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ main_site | json }},
    "sameAs": [
      "https://www.instagram.com/temperastrings",
      "https://facebook.com/temperastrings",
      "https://www.youtube.com/c/temperastrings"
    ]
  }
</script>

{% schema %}
{
  "name": "Tempera header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
