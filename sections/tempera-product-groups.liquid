{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="tempera-product-groups section-{{ section.id }}-padding" id="TemperaProductGroups">
  <div class="page-width">
    {%- for block in section.blocks -%}
      {%- liquid
        assign heading = block.settings.heading_en
        if request.locale.iso_code == 'de' and block.settings.heading_de != blank
          assign heading = block.settings.heading_de
        endif
        assign product_count = 0
        if block.settings.product_1 != blank
          assign product_count = product_count | plus: 1
        endif
        if block.settings.product_2 != blank
          assign product_count = product_count | plus: 1
        endif
        if block.settings.product_3 != blank
          assign product_count = product_count | plus: 1
        endif
        if block.settings.product_4 != blank
          assign product_count = product_count | plus: 1
        endif
      -%}

      {%- if product_count > 0 -%}
        <section class="tempera-product-group" aria-labelledby="TemperaGroup-{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="collection__title title-wrapper title-wrapper--no-top-margin">
            <h2 class="title h1" id="TemperaGroup-{{ block.id }}">{{ heading | escape }}</h2>
          </div>
          <ul
            class="grid product-grid contains-card contains-card--product contains-card--standard grid--4-col-desktop grid--2-col-tablet-down"
            role="list"
          >
            {%- for product_index in (1..4) -%}
              {%- assign setting_key = 'product_' | append: product_index -%}
              {%- assign card_product = block.settings[setting_key] -%}
              {%- if card_product != blank -%}
                <li class="grid__item">
                  {% render 'card-product',
                    card_product: card_product,
                    media_aspect_ratio: 'square',
                    show_secondary_image: false,
                    show_vendor: false,
                    show_rating: false,
                    show_quick_add: false,
                    section_id: section.id
                  %}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Tempera product groups",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Product group",
      "settings": [
        {
          "type": "text",
          "id": "heading_en",
          "label": "Heading (English)",
          "default": "Strings"
        },
        {
          "type": "text",
          "id": "heading_de",
          "label": "Heading (German)",
          "default": "Saiten"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tempera product groups",
      "blocks": [
        { "type": "group" },
        { "type": "group" }
      ]
    }
  ]
}
{% endschema %}
